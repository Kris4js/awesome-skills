{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {}
  },
  "include": [
    "templates/**/*.ts",
    "templates/**/*.tsx",
    "gallery/**/*.tsx",
    "gallery/env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
