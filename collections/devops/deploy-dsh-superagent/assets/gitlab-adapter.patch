+/** GitLab MR lifecycle adapter. Work starts in Feishu; only bound MR discussions are received. */
+import type { Context } from '@deepseek-ai/cordis'
+import { z } from 'zod'
+import { GitlabAccountsSchema } from '../deployment.ts'
+import { key, liveTicket, type OutboundMessage, type Ticket } from '../core/index.ts'
+import type { Commands } from '../infra/commands.ts'
+import type { SourceKind } from './kind.ts'
+import { sourceContext, type SourceContext } from './host.ts'
+import { pause, polled } from './poll.ts'
+import { ticketBranch } from './github-pull.ts'
+
+export const SOURCE = 'gitlab'
+const Author = z.object({ id: z.number(), username: z.string(), bot: z.boolean().optional() })
+export const MergeRequestSchema = z.object({ iid: z.number().int().positive(), title: z.string(), state: z.enum(['opened', 'closed', 'merged', 'locked']),
+  web_url: z.url(), author: Author, source_branch: z.string(), target_branch: z.string(), source_project_id: z.number().nullable(), target_project_id: z.number(),
+  description: z.string().nullable(), created_at: z.string(), updated_at: z.string(), merged_at: z.string().nullable(), closed_at: z.string().nullable(),
+  head_pipeline: z.object({ id: z.number(), sha: z.string(), status: z.string() }).nullable().optional() })
+export type MergeRequest = z.infer<typeof MergeRequestSchema>
+const Note = z.object({ id: z.number(), body: z.string(), author: Author, created_at: z.string(), system: z.boolean() })
+type Note = z.infer<typeof Note>
+const ConfigSchema = GitlabAccountsSchema.extend({ pollSeconds: z.number().int().min(15).max(3600).default(30) })
+const ref = (iid: number) => ({ source: SOURCE, id: `mr:${iid}` })
+const threadKey = (iid: number) => `${SOURCE}:mr:${iid}`
+const iidOf = (thread: string): number | undefined => /^gitlab:mr:([1-9]\d*)$/.test(thread) ? Number(thread.split(':')[2]) : undefined
+export const readMergeRequest = async (ctx: SourceContext, iid: number, signal?: AbortSignal): Promise<MergeRequest> => {
+  const mr = await ctx.commands.withSignal(signal).gitlab(MergeRequestSchema, `merge_requests/${iid}`)
+  if (mr.iid !== iid || mr.target_project_id !== ctx.deployment.gitlab?.projectId) throw new Error('GitLab returned a different MR or project')
+  return { ...mr, web_url: `${ctx.deployment.gitlab.webUrl}/-/merge_requests/${iid}` }
+}
+
+/** Refuse cross-project, wrong-author and wrong-branch claims before subscribing a ticket. */
+export function claimMergeRequest(ctx: SourceContext, ticketId: string, mr: MergeRequest): string | undefined {
+  const ticket = ctx.tickets.get(ticketId), config = ctx.deployment.gitlab
+  if (!ticket || !liveTicket(ticket) || !config) return 'No live GitLab ticket'
+  if (mr.source_project_id !== config.projectId || mr.target_project_id !== config.projectId ||
+      mr.author.username !== ctx.deployment.github.login || !ticketBranch(ticket, mr.source_branch))
+    return 'MR must be authored by the configured bot in this project, on this ticket branch'
+  if (new URL(mr.web_url).origin !== new URL(config.webUrl).origin) return 'MR URL is outside the configured GitLab host'
+  const owner = ctx.tickets.open().find(t => (t.follows ?? []).some(f => f.thread === threadKey(mr.iid) && !f.closed))
+  if (owner && owner.id !== ticketId) return 'MR already belongs to another ticket'
+  const prior = ticket.follows?.find(f => f.thread === threadKey(mr.iid))
+  if (mr.state === 'closed' || mr.state === 'merged') {
+    if (!prior) return 'Cannot attach an already-closed MR as a new deliverable'
+    return
+  }
+  if (!prior || prior.closed) {
+    ctx.tickets.bindThread(ticketId, ref(mr.iid), true)
+    ctx.threads.patch(threadKey(mr.iid), { iid: mr.iid, url: mr.web_url, boundAt: new Date().toISOString() })
+  }
+  ctx.threads.describe(threadKey(mr.iid), { label: `MR !${mr.iid}: ${mr.title}`, url: mr.web_url })
+}
+
+async function notes(commands: Commands, iid: number): Promise<Note[]> {
+  const result: Note[] = []
+  for (let page = 1; ; page++) {
+    const items = await commands.gitlab(z.array(Note), `merge_requests/${iid}/notes?sort=asc&order_by=created_at&per_page=100&page=${page}`)
+    result.push(...items)
+    if (items.length < 100) return result
+    if (page >= 100) throw new Error('MR discussion exceeds polling page limit; cursor not advanced')
+  }
+}
+async function send(ctx: Pick<SourceContext, 'commands'>, message: OutboundMessage): Promise<'sent'> {
+  const iid = Number(message.channel.address.iid)
+  if (!Number.isSafeInteger(iid) || iid <= 0) throw new Error('Invalid MR reply target')
+  const marker = `<!-- dsh-superagent:${message.id} -->`
+  if ((await notes(ctx.commands, iid)).some(n => n.author.username === ctx.commands.deployment.github.login && n.body.includes(marker))) return 'sent'
+  await ctx.commands.gitlab(z.unknown(), `merge_requests/${iid}/notes`, '--method', 'POST', '-f', `body=${message.text}\n\n${marker}`)
+  return 'sent'
+}
+
+export const gitlabKind: SourceKind<z.infer<typeof ConfigSchema>> = {
+  kind: SOURCE, title: { zh: 'GitLab', en: 'GitLab' },
+  description: { zh: '从飞书接单，跟踪工单关联的 MR、讨论和流水线。', en: 'Feishu-origin work with bound MR discussions, pipelines and lifecycle.' },
+  schema: ConfigSchema, health: ['gitlab'],
+  fields: [
+    { key: 'host', type: 'text', label: { zh: 'GitLab 主机', en: 'GitLab host' } },
+    { key: 'repository', type: 'text', label: { zh: '项目路径', en: 'Project path' } },
+    { key: 'cli', type: 'text', label: { zh: '智能体 glab', en: 'Agent glab' } },
+    { key: 'pollSeconds', type: 'number', min: 15, max: 3600, label: { zh: '轮询间隔 / 秒', en: 'Polling interval / seconds' } },
+  ],
+  scope: () => ({ listened: true, observed: false }),
+  find: query => { const iid = /^!?(\d+)$/.exec(query.trim())?.[1]; return { threads: iid ? [threadKey(Number(iid))] : [], terms: [] } },
+  channel: { send, link: (address, links) => ({ url: links.gitlab ? `${links.gitlab.webUrl}/-/merge_requests/${Number(address.iid)}` : '', label: { zh: `MR !${address.iid}`, en: `MR !${address.iid}` } }) },
+  threadContext: {
+    messageId: t => String(t.meta.noteId ?? ''),
+    async read(commands, trigger, part, cursor) {
+      const iid = Number(trigger.meta.iid)
+      if (!Number.isSafeInteger(iid) || iid <= 0) throw new Error('Invalid MR context')
+      const mr = await commands.gitlab(MergeRequestSchema, `merge_requests/${iid}`)
+      if (mr.target_project_id !== commands.deployment.gitlab?.projectId) throw new Error('GitLab returned a different project')
+      mr.web_url = `${commands.deployment.gitlab.webUrl}/-/merge_requests/${iid}`
+      if (part !== 'thread') return { messages: [{ id: `mr:${iid}`, from: mr.author.username, at: mr.created_at, text: mr.description ?? mr.title, url: mr.web_url }], body: {} }
+      const page = cursor === undefined ? 1 : Number(cursor)
+      if (!Number.isSafeInteger(page) || page < 1) throw new Error('Invalid cursor')
+      const list = await commands.gitlab(z.array(Note), `merge_requests/${iid}/notes?sort=asc&order_by=created_at&per_page=50&page=${page}`)
+      return { messages: list.map(n => ({ id: String(n.id), from: n.author.username, at: n.created_at, text: n.body, url: `${mr.web_url}#note_${n.id}`, ...(n.system || n.author.bot ? { bot: true as const } : {}) })),
+        body: { title: mr.title, state: mr.state }, ...(list.length === 50 ? { next: String(page + 1) } : {}) }
+    },
+  },
+  policy: {
+    schema: z.object({ allowed: z.array(z.object({ id: z.string().min(1) })).default([]) }),
+    fields: [{ key: 'allowed', type: 'rows', label: { zh: '能发起工作的账号', en: 'Allowed accounts' }, columns: [{ key: 'id', type: 'text', label: { zh: '账号', en: 'Account' } }] }],
+    explicit: { zh: '首版仅接收已关联 MR 的后续讨论；新任务从飞书发起。', en: 'Only bound MR discussions are received; start new work in Feishu.' },
+  },
+  environment: {
+    variables: [
+      { key: 'DSH_SUPERAGENT_GITLAB_REPOSITORY', description: { zh: 'GitLab 项目路径', en: 'GitLab project path' } },
+      { key: 'DSH_SUPERAGENT_GITLAB_HOST', description: { zh: 'GitLab 主机', en: 'GitLab host' } },
+      { key: 'DSH_SUPERAGENT_GITLAB_ACCOUNT', description: { zh: '智能体账号', en: 'Agent account' } },
+      { key: 'DSH_SUPERAGENT_GITLAB_COMMIT_EMAIL', description: { zh: '提交邮箱', en: 'Commit email' } },
+      { key: 'DSH_SUPERAGENT_GITLAB_CLONE_URL', description: { zh: '仓库 HTTPS 地址', en: 'Repository HTTPS URL' } },
+    ],
+    values: ({ deployment: d }) => ({ DSH_SUPERAGENT_GITLAB_REPOSITORY: d.repository, DSH_SUPERAGENT_GITLAB_HOST: d.gitlab?.host ?? '',
+      DSH_SUPERAGENT_GITLAB_ACCOUNT: d.github.login, DSH_SUPERAGENT_GITLAB_COMMIT_EMAIL: d.github.noreply, DSH_SUPERAGENT_GITLAB_CLONE_URL: d.gitlab?.cloneUrl ?? '' }),
+  },
+}
+
+export async function pollMergeRequests(ctx: SourceContext, signal: AbortSignal): Promise<void> {
+  const commands = ctx.commands.withSignal(signal)
+  // Recover MR binding if a worker created the MR but crashed before its report.
+  for (let page = 1; ; page++) {
+    const list = await commands.gitlab(z.array(z.object({ iid: z.number(), source_branch: z.string() })),
+      `merge_requests?state=opened&author_username=${encodeURIComponent(ctx.deployment.github.login)}&per_page=100&page=${page}`)
+    for (const item of list) {
+      const candidates = ctx.tickets.open().filter(t => ticketBranch(t, item.source_branch))
+      if (candidates.length === 1) {
+        const mr = await readMergeRequest(ctx, item.iid, signal)
+        ctx.atomic(() => { const error = claimMergeRequest(ctx, candidates[0]!.id, mr); if (error) throw new Error(error) })
+      }
+    }
+    if (list.length < 100) break
+    if (page >= 100) throw new Error('Open MR list exceeds page limit')
+  }
+  for (const thread of ctx.threads.subscribed(SOURCE)) {
+    if (signal.aborted || !polled(ctx, thread)) continue
+    const iid = iidOf(thread.key)
+    if (!iid) continue
+    const mr = await readMergeRequest(ctx, iid, signal)
+    for (const note of await notes(commands, iid)) {
+      if (note.system || note.author.username === ctx.deployment.github.login || Date.parse(note.created_at) < Date.parse(String(thread.meta.boundAt ?? mr.created_at))) continue
+      await ctx.receive({ id: key(SOURCE, String(ctx.deployment.gitlab!.projectId), 'note', String(note.id)), source: SOURCE, threads: [ref(iid)],
+        actor: { source: SOURCE, id: note.author.username }, human: !note.author.bot, at: note.created_at, text: note.body,
+        ...(note.body.includes(`@${ctx.deployment.github.login}`) ? { addressed: 'mention' as const } : {}),
+        url: `${mr.web_url}#note_${note.id}`, channel: { source: SOURCE, thread: threadKey(iid), address: { iid: String(iid) } }, meta: { iid, noteId: note.id } })
+    }
+    const pipeline = mr.head_pipeline
+    if (pipeline) await ctx.receive({ id: key(SOURCE, 'pipeline', String(pipeline.id), pipeline.status), source: SOURCE, threads: [ref(iid)], actor: { source: SOURCE, id: 'gitlab-ci' }, human: false,
+      at: mr.updated_at, text: `MR !${iid} pipeline ${pipeline.id}: ${pipeline.status}, SHA ${pipeline.sha}`, meta: { iid, pipeline: pipeline.id },
+      channel: { source: SOURCE, thread: threadKey(iid), address: { iid: String(iid) } } })
+    if (mr.state === 'merged' || mr.state === 'closed') ctx.tickets.threadClosed(ref(iid), mr.state, mr.merged_at ?? mr.closed_at ?? mr.updated_at)
+  }
+}
+
+export function mergeEndNotices(ticket: Ticket, webUrl: string): OutboundMessage[] {
+  const outcome = ticket.ended?.outcome
+  const follows = (ticket.follows ?? []).filter(f => f.closed && iidOf(f.thread))
+  const own = follows.filter(f => f.own)
+  const last = (own.length ? own : follows).sort((a, b) => b.closed!.at.localeCompare(a.closed!.at))[0]
+  if (!last || (outcome !== 'merged' && outcome !== 'closed')) return []
+  const iid = iidOf(last.thread)!
+  const text = `[MR !${iid}](${webUrl}/-/merge_requests/${iid}) ${outcome === 'merged' ? '已合并。' : '已关闭，未合并。'}`
+  return ticket.channels.filter(c => c.source !== SOURCE).map(channel => ({ id: key('mr-terminal', ticket.id, String(iid), outcome, JSON.stringify(channel)),
+    channel, text, kind: 'notice', ticketId: ticket.id }))
+}
+export const name = 'dsh-superagent-gitlab'
+export const inject = ['orchestrator']
+export function apply(ctx: Context): void {
+  ctx.effect(() => ctx.orchestrator.sources.register(gitlabKind), 'gitlab: source kind')
+  ctx.effect(() => {
+    const stop = new AbortController(), host = sourceContext(ctx.orchestrator, gitlabKind)
+    const running = (async () => {
+      await host.ready
+      while (!stop.signal.aborted) {
+        const config = host.config<z.infer<typeof ConfigSchema>>(SOURCE)
+        if (config && host.configured() && host.deployment.gitlab) {
+          try { await pollMergeRequests(host, stop.signal); host.report('gitlab', { state: 'ready', detail: 'Watching bound merge requests' }) }
+          catch (error) { if (!stop.signal.aborted) host.report('gitlab', { state: 'error', detail: String(error) }) }
+        }
+        await pause((config?.pollSeconds ?? 30) * 1000, stop.signal)
+      }
+    })()
+    return async () => { stop.abort(); await running }
+  })
+}
