+  const bindThread = vi.fn(), patch = vi.fn()
+  const ctx = { deployment: deployment(), tickets: { get: () => ticket, open: () => [ticket], bindThread }, threads: { patch, describe: vi.fn() } } as unknown as SourceContext
+  return { ctx, ticket, bindThread, patch }
