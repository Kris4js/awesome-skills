+    const ticket = { ...h.ticket, ended: { outcome: 'merged' }, follows: [{ thread: 'gitlab:mr:7', own: true, closed: { at: '2026-11-01T00:00:00Z', outcome: 'merged' } }],
+      channels: [{ source: 'feishu', thread: 'x', address: { messageId: 'm' } }] } as unknown as Ticket
+    const messages = mergeEndNotices(ticket, gitlab.webUrl)
+    expect(messages).toHaveLength(1)
+    expect(messages[0]!.text).toContain(`${gitlab.webUrl}/-/merge_requests/7`)
+    expect(messages).toEqual(mergeEndNotices(ticket, gitlab.webUrl))
