+  await commands.gitlab(z.object({}), 'merge_requests/7')
+  expect(run.mock.calls[0]![1]).toContain('projects/12/merge_requests/7')
+  for (const path of ['../13', '/projects/13', 'https://evil.test', '%2e%2e/13']) await expect(commands.gitlab(z.object({}), path)).rejects.toThrow('restricted')
+  await expect(commands.api('')).rejects.toThrow('GitHub API unavailable')
