 export interface Deployment extends Machine {
   repository: string
   github: { cli: string; login: string; noreply: string }
+  /** GitLab deployments retain github's account fields as a legacy execution identity; GitHub API calls are disabled. */
+  gitlab?: { host: string; projectId: number; webUrl: string; cloneUrl: string; defaultBranch: string }
   feishu?: FeishuBot
 }
+
+/** Resolve a GitLab project and verify the configured bot can create development branches. */
+export async function resolveGitlabDeployment(machine: Machine, input: unknown, probe: Probe, path = process.env.PATH ?? ''): Promise<Deployment> {
+  try {
+    const config = GitlabAccountsSchema.parse(input)
+    if (!config.repository || !config.cli) throw new Error('Configure the GitLab repository and glab executable')
+    const cli = executable(config.cli, path, workerBin(machine.stateDir))
+    const api = async (endpoint: string) => JSON.parse(await probe([cli, 'api', '--hostname', config.host, endpoint]))
+    const user = z.object({ id: z.number(), username: z.string().min(1), is_admin: z.boolean().optional(), public_email: z.string().nullable().optional() }).parse(await api('user'))
+    if (user.is_admin) throw new Error('Use a non-administrator GitLab automation account')
+    const project = z.object({ id: z.number().int().positive(), path_with_namespace: z.string(), web_url: z.url(), http_url_to_repo: z.url(),
+      default_branch: z.string().min(1), archived: z.boolean(), permissions: z.object({
+        project_access: z.object({ access_level: z.number() }).nullish(), group_access: z.object({ access_level: z.number() }).nullish(),
+      }) }).parse(await api(`projects/${encodeURIComponent(config.repository)}`))
+    if (project.archived || Math.max(project.permissions.project_access?.access_level ?? 0, project.permissions.group_access?.access_level ?? 0) < 30)
+      throw new Error('An unarchived project and Developer access are required')
+    if (project.path_with_namespace !== config.repository)
+      throw new Error('GitLab returned a different project')
+    // Reverse-proxied GitLab may advertise an internal external_url. Never send credentials there.
+    const webUrl = `https://${config.host}/${project.path_with_namespace}`
+    return { ...machine, repository: project.path_with_namespace,
+      github: { cli, login: user.username, noreply: user.public_email || `${user.id}-${user.username}@users.noreply.${config.host.split(':')[0]}` },
+      gitlab: { host: config.host, projectId: project.id, webUrl, cloneUrl: `${webUrl}.git`, defaultBranch: project.default_branch } }
+  } catch (error) { throw new SetupError('gitlabSetupFailed', { output: reason(error) }) }
+}
